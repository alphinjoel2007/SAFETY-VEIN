# Build a single feature vector from current sensor reads
def build_feature_vector(dht_pin, mpu, analog_reader=analog_reader_sim):
    d = read_dht(dht_pin)
    mq = read_mq_values(analog_reader)
    accel_rms = compute_accel_rms(mpu) if mpu else 0.0
    # Optional heart/spo2 readings from MAX30102 would be added here using its driver
    # For now use placeholders:
    hr = 70.0
    spo2 = 98.0
    features = {
        'temperature': d['temperature'],
        'humidity': d['humidity'],
        'mq4': float(mq['mq4']),
        'mq7': float(mq['mq7']),
        'mq136': float(mq['mq136']),
        'accel_rms': float(accel_rms),
        'hr': float(hr),
        'spo2': float(spo2)
    }
    return features
