def compute_accel_rms(mpu, samples=50, delay=0.01):
    vals = []
    for _ in range(samples):
        ax, ay, az = mpu.read_accel()
        # remove gravity bias for small vibrations: subtract 1g on Z if needed
        g = 1.0
        mag = math.sqrt(ax*ax + ay*ay + (az - g)**2)
        vals.append(mag)
        time.sleep(delay)
    arr = np.array(vals)
    return float(np.sqrt(np.mean(arr**2)))

