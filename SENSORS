# MPU6050 class: simple I2C read to compute short-term RMS for microseismic
class MPU6050:
    def __init__(self, bus=1, addr=0x68):
        if smbus2 is None:
            raise RuntimeError("smbus2 required for MPU6050")
        self.bus = smbus2.SMBus(bus)
        self.addr = addr
        # wake up sensor
        self.bus.write_byte_data(self.addr, 0x6B, 0)
    def read_accel(self):
        # read raw accel registers
        def read_word(reg):
            hi = self.bus.read_byte_data(self.addr, reg)
            lo = self.bus.read_byte_data(self.addr, reg+1)
            val = (hi << 8) | lo
            if val >= 0x8000:
                val = -((65535) - val + 1)
            return val
        ax = read_word(0x3B) / 16384.0
        ay = read_word(0x3D) / 16384.0
        az = read_word(0x3F) / 16384.0
        return ax, ay, az

# Example read functions (simulate when hardware not present)
def read_dht(pin=4):
    if Adafruit_DHT is None:
        return {'temperature': 25.0, 'humidity': 50.0}
    h, t = Adafruit_DHT.read_retry(Adafruit_DHT.DHT22, pin)
